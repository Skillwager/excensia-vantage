# Match data is never committed: the competition assets are not redistributable,
# and the open training matches are fetched by scripts/fetch_external.py.
data/
runs/
external/
*.mp4
*.mov
*.MTS

.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

viewer/node_modules/
viewer/shots/
.linux-site/

# The files that go into the submission form. Built locally, not kept in the repository.
submission/

# What the run and export commands write, wherever they are asked to write it: a file of
# labels, its receipt, a run file or a viewer page of the competition match. None of them
# belongs in a public repository.
*.csv
*.receipt.json
*.run.json
/run.json
/*.html
*.npz
*.mkv
*.webm
*.avi
*.m4v
*.MP4
*.MOV
